<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Spinner
        android:id="@+id/spinnerFiltroHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMascotasHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/spinnerFiltroHome"
        android:layout_above="@+id/layoutBotones" />

    <LinearLayout
        android:id="@+id/layoutBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button android:id="@+id/btnVerMapa" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Ver Mapa" />
        <Button android:id="@+id/btnIrPerfil" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mi Perfil" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddPet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@id/layoutBotones"
        android:layout_margin="20dp"
        app:srcCompat="@android:drawable/ic_input_add" />

</RelativeLayout>