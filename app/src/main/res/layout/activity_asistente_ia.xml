<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asistente PetConnect AI"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etConsultaIA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: ¿Qué vacunas necesita un cachorro de 3 meses?" />

    <Button
        android:id="@+id/btnPreguntarIA"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preguntar a la IA"
        android:layout_marginTop="10dp" />

    <ProgressBar
        android:id="@+id/pbCargandoIA"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="15dp">
        <TextView
            android:id="@+id/tvRespuestaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:text="La respuesta aparecerá aquí..." />
    </ScrollView>
</LinearLayout>